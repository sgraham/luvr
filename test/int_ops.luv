# OUT: 3
# OUT: -3
# OUT: -3
# OUT: 1
# OUT: -1
# OUT: 1
# OUT: 4
# OUT: 14
# OUT: 6
# OUT: 40
# OUT: -2
# OUT: 1073741820
# OUT: 4294967295
# OUT: 2147483647
# OUT: 1
# OUT: 9223372036854775807
# OUT: 18446744073709551614
# OUT: 4
# OUT: 2
# OUT: 7

# Integer operators that aren't folded, at 32 and 64 bits. Division truncates
# toward zero, and % has the sign of the dividend.
def int main():
    int a = 10
    int b = -3
    int c = 3
    int na = -10
    print a / c
    print a / b
    print na / c
    print a % c
    print na % c
    print a % b
    i32 m = 12
    i32 n = 10
    print m & 6
    print m | n
    print m ^ n
    i32 five = 5
    print five << c
    print b >> 1
    u32 big = 4294967283
    print big >> 2
    u32 mx = 4294967295
    print mx
    print mx / 2
    print mx % 2
    u64 umx = 18446744073709551615
    print umx >> 1
    print umx - 1
    x = 20
    x /= 5
    print x
    x %= c
    x <<= 1
    print x
    x |= 5
    print x
    return 0
