# OUT: 0.1
# OUT: 1.2345679e+08
# OUT: 3.0
# OUT: 1.6777216e+07

# f32 constants and locals are rounded to f32, and are printed with the fewest
# digits that read back as the same f32.
def int main():
    f32 a = 0.1
    print a
    f32 b = 123456789.0
    print b
    f32 c = 3
    print c
    a = 16777216
    print a
    return 0
