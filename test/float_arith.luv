# OUT: 4.0
# OUT: -1.0
# OUT: 3.75
# OUT: 0.6
# OUT: -1.5
# OUT: 1.6777216e+07
# OUT: 1.6777218e+07
# OUT: 0.33333334
# OUT: 4.5
# OUT: inf
# OUT: -inf

# Float +, -, *, / and unary '-' on values that aren't constants. f32 results
# are rounded to f32.
def int main():
    f64 a = 1.5
    f64 b = 2.5
    print a + b
    print a - b
    print a * b
    print a / b
    print -a
    f32 big = 16777216
    print big + 1
    print big + 2
    f32 third = 1
    third /= 3
    print third
    x = a * 2 + 1.5
    print x
    f64 zero = 0
    print a / zero
    print -a / zero
    return 0
