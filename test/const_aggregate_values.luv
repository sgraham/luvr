struct Point:
    int x
    int y

GREETING = "hi"
HELLO = GREETING
ORIGIN = Point(1, 2)
[3]int PRIMES = [2, 3, 5]

struct Named:
    str name = GREETING
    Point at = ORIGIN

def show(Point pt):
    print pt.x
    print pt.y

def Point origin():
    return ORIGIN

def int main():
    print GREETING
    print HELLO
    show(origin())
    ps = PRIMES
    print ps[1]
