# OUT: 1.500000
# OUT: 0.100000
# OUT: 2.000000
# OUT: 3.000000
# OUT: -0.250000
# OUT: 123456789.125000

# f64 constants, locals, and printing them.
def int main():
    f64 a = 1.5
    print a
    a = 0.1
    print a
    b = 2.0
    print b
    f64 c = 3
    print c
    print -0.25
    print 123456789.125
    return 0
