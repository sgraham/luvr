# OUT: 3
# OUT: 4

# Loops without a condition can only be left by a break or return.
def int f(int n):
    i = 0
    for:
        i += 1
        if i == n:
            return i

def int g(int n):
    i = 0
    for:
        i += 1
        if i == n:
            break
        for:
            break
    return i

def int main():
    print f(3)
    print g(4)
    return 0
