# OUT: -5
# OUT: 5
# OUT: -128
# OUT: 65535
# OUT: -6
# OUT: 15
# OUT: -9223372036854775808
# OUT: 18446744073709551610
# OUT: -11
# OUT: 10
# OUT: 0

# Unary '-' and '~' on integers that aren't constants, at each width.
def int main():
    i32 a = 5
    print -a
    print -(-a)
    i8 lo = -128
    print -lo
    u16 z = 0
    print ~z
    i8 five = 5
    print ~five
    u8 f0 = 240
    print ~f0
    i64 mn = -9223372036854775807 - 1
    print -mn
    u64 big = 5
    print ~big
    int ten = 10
    print ~ten
    print ~~ten
    print ~ten + 11
    return 0
