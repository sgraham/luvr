import "mod"

struct Pair{A, B}:
    A first
    B second

struct List{T}:
    *T data
    int len

struct Nested{K, V}:
    List{Pair{K, V}} items
    mod.Map{K, []V} index
    {K}List{V} by_key

List{int} global_list = List{int}(.data=null, .len=0)

on Pair{A, B} def A get_first(self):
    return self.first

on List{T} def U map_len{U}(self, U seed):
    return seed

on List{T} foreign int raw_len(self)

on List{E} def List{E} new(int cap):
    return List{E}(.data=null, .len=0)

# Builtin receivers are only valid in the module that defines builtin types.
on []T def T first(self):
    return self[0]

on {K}V def int count(self):
    return len(self)

on str def int byte_len(self):
    return len(self)

def T max{T}(T a, T b):
    if a > b:
        return a
    return b

def swap{T}(*T a, *T b):
    T tmp = a[0]
    a[0] = b[0]
    b[0] = tmp

def List{T} make{T}(int n):
    return List{T}(.data=null, .len=n)

def mod.Box{T} boxed{T}(mod.Box{T} b, mod.Opt{List{T}} o):
    return b

def main():
    List{int} xs = make{int}(0)
    *List{int} q = null
    x = 1
    y = 2
    List{List{int}} xss = make{List{int}}(4)
    Pair{int, str} p = Pair{int, str}(.first=1, .second="x")
    mod.Map{str, int} m = mod.new_map{str, int}()
    n = max(1, 2)
    k = max{u64}(n, 3) + max{u64}(1, 2) * 4
    big = n < k and k > n
    f = max{int}
    xs.map_len{int}(0)
    s = sizeof(Pair{int, int})
    a = alignof(mod.Map{str, int})
    o = offsetof(Pair{int, int}, second)
    c = cast *List{int}(q)
    d = {1: List{int}(.len=0)}
    e = [Pair{int, int}(.first=1, .second=2), Pair{int, int}(.first=3, .second=4)]
    t = mod.Thing{int}.create()
    l = List{int}.new(4)
    print max{int}(
        1,
        2)
    if x < y:
        pass
    swap{int}(&n, &k)
