import "mod"

struct Pair{A, B}:
    A first
    B second

struct List{T}:
    *T data
    int len

struct Nested{K, V}:
    List{Pair{K, V}} items
    mod.Map{K, []V} index
    {K}List{V} by_key

List{int} global_list

on Pair{A, B} def A get_first(self):
    return self.first

on List{T} foreign i64 raw_len(self)

on List{E} def List{E} new(int cap):
    return List{E}(.data=null, .len=0)

# A nested function sees its method's receiver type parameters.
on List{T} def int count_nested(self):
    def int g(T x, List{T} xs):
        return xs.len
    return g(self.data[0], self)

# Builtin receivers are only valid in the module that defines builtin types.
on []T def T first(self):
    return self[0]

on {K}V def int count(self):
    return len(self)

on str def int byte_len(self):
    return len(self)

on List{T} def mod.Box{T} boxed(self, mod.Box{T} b, mod.Opt{List{T}} o):
    return b

def main():
    List{int} xs = List{int}.new(0)
    *List{int} q = null
    x = 1
    y = 2
    List{List{int}} xss = List{List{int}}.new(4)
    Pair{int, str} p = Pair{int, str}(.first=1, .second="x")
    mod.Map{str, int} m = mod.Map{str, int}.new()
    n = max(1, 2)
    k = max(n, 3) + max(1, 2) * 4
    big = n < k and k > n
    s = sizeof(Pair{int, int})
    a = alignof(mod.Map{str, int})
    o = offsetof(Pair{int, int}, second)
    c = cast *List{int}(q)
    d = {1: List{int}(.len=0)}
    e = [Pair{int, int}(.first=1, .second=2), Pair{int, int}(.first=3, .second=4)]
    t = mod.Thing{int}.create()
    l = List{int}.new(4)
    print Pair{
        int,
        str}(.first=1, .second="x").first
    if x < y:
        pass
