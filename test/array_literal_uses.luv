struct Holder:
    [2]int pair

def int sum([3]int nums):
    return nums[0] + nums[1] + nums[2]

def [3]int tens():
    return [10, 20, 30]

def int main():
    print sum([1, 2, 3])
    print tens()[2]

    [3]int nums = [0, 0, 0]
    nums = [7, 8, 9]
    print nums[2]

    Holder h
    h.pair = [4, 8]
