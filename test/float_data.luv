# OUT: 1.5
# OUT: 3.5
# OUT: 0.1
# OUT: 3.0
# OUT: 0.0
# OUT: 0.33333334
# OUT: 2.5
# OUT: 0.25
# OUT: -4.0
# OUT: 0.5
# OUT: 1e+300

# Floats in data: global initializers, a global without one, named
# constants, struct field defaults, and struct and array literals.
f64 big = 1.5
f32 small = 0.1
f64 from_int = 3
f64 zeroed
f32 THIRD = 1 / 3.0

struct Defaults:
    f64 x = 2.5
    f32 y = 0.25
    int n = 7

struct Pair:
    f64 a
    f32 b

Pair pair = Pair(.a=-4.0, .b=0.5)

def int main():
    print big
    big += 2
    print big
    print small
    print from_int
    print zeroed
    print THIRD
    d = Defaults()
    print d.x
    print d.y
    print pair.a
    print pair.b
    [2]f64 arr = [1.5, 1e300]
    print arr[1]
    return 0
