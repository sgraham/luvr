# OUT: 3
# OUT: 12
# OUT: 999
def int main():
    x = 3
    px = &x

    def int middle() uses x, px:
        y = 4

        def int inner() uses x, y:
            return x + y + 5

        # Ensure inner() captured by value at def point.
        y = 100
        px[0] = 999

        return inner()

    print x
    print middle()
    print x
    return 0
