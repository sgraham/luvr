# OUT: 5
# OUT: 6
# OUT: 9
# OUT: 4
struct Point:
    int x
    int y

struct Box:
    Point lo
    Point hi

def Point origin_plus(int dx, int dy):
    return Point(dx, dy)

def Point swapped(Point pt):
    Point out
    out.x = pt.y
    out.y = pt.x
    return out

def Point high(Box b):
    return b.hi

def int sum(Point pt):
    return pt.x + pt.y

def [3]int counts(int first):
    [3]int nums
    nums[0] = first
    nums[2] = first + 2
    return nums

def Box grow(Box b):
    return Box(b.lo, swapped(b.hi))

def int main():
    p = origin_plus(1, 2)
    print p.x
    print p.y
    print sum(origin_plus(3, 4))

    b = Box(p, Point(40, 30))
    print high(b).y
    print swapped(high(b)).y
    print swapped(p).y + 1
    b.lo = origin_plus(5, 6)
    print b.lo.x + b.lo.y
    origin_plus(100, 200)
    print b.lo.x

    nums = counts(4)
    print nums[2]
    print sum(grow(b).lo) - 2
    print counts(nums[0])[0]
    return 0
