# Parsed before every program as module 0. Its definitions are visible in
# every module, after the module's own globals, and can be shadowed.

# The fields are only for the prelude's own methods. Other code passes the str
# itself, and uses len() for its length. The compiler builds and reads strs
# through these fields, by name.
struct str:
    *u8 _data
    int _len


# Not implemented yet. Calls are checked, but can't be emitted.
on str foreign str join(self, []str parts)


struct Range:
    int start
    int stop
    int step


# The position of a loop over a Range. It doesn't refer to the Range, so it
# stays valid if the Range is a temporary. The number of elements is found
# up front, as Python does, so that a step past either end of int can't wrap
# into another element. The fields are unsigned because they're expected
# to wrap.
struct RangeIter:
    u64 _cur
    u64 _step
    u64 _left


on Range def RangeIter __iter__(self):
    u64 start = cast u64(self.start)
    u64 step = cast u64(self.step)
    u64 left = 0
    # Unsigned subtraction of the bits gives the exact distance between two
    # ints, even when the signed difference would overflow.
    if self.step > 0 and self.start < self.stop:
        left = (cast u64(self.stop) - start - 1) / step + 1
    if self.step < 0 and self.start > self.stop:
        left = (start - cast u64(self.stop) - 1) / (~step + 1) + 1
    return RangeIter(start, step, left)


on RangeIter def bool __next__(self, *int out):
    if self._left == 0:
        return false
    out[0] = cast int(self._cur)
    self._cur += self._step
    self._left -= 1
    return true
