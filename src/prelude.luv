# Parsed before every program as module 0. Its definitions are visible in
# every module, after the module's own globals, and can be shadowed.

# The fields are only for the prelude's own methods. Other code passes the str
# itself, and uses len() for its length. The compiler builds and reads strs
# through these fields, by name.
struct str:
    *u8 _data
    int _len


# Not implemented yet. Calls are checked, but can't be emitted.
on str foreign str join(self, []str parts)


### struct Range:
###     int start
###     int stop
###     int step
###
###
### struct RangeIter:
###     Range _over
###     int _cur
###
###
### on Range def RangeIter __iter__(self):
###     return RangeIter(self, start)
###
###
### on RangeIter def IterResult{int} __next__(self):
###     if self._over.step < 0:
###         # TODO
###         pass
###     else:
###         if self._cur >= stop:
###             return IterResult{int}(false, 0)
###         ret = IterResult{int}(true, self._cur)
###         self._cur += self._over.step
###         return ret
###
###
### on Range def bool __contains__(self, int value):
###     if self.step == 0:
###         return false
###
###     # Outside the range bounds.
###     if self.step > 0:
###         if value < self.start or value >= self.stop:
###             return false
###     else:
###         if value > self.start or value <= self.stop:
###             return false
###
###     # Check if value is on the corect stride.
###     diff = value - self.start
###     return diff % self.step == 0
###
###
### on Range def str __str__(self):
###     if self.step == 1:
###         return "range(\(self.start), \(self.stop))"
###     else:
###         return "range(\(self.start), \(self.stop), \(self.step))"
